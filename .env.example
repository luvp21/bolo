# Copy to .env.local and fill in. Never commit .env.local.

# Gnani API key: https://app.gnani.ai/voice (each registration gets 5,000 programme credits)
GNANI_API_KEY=

# Optional Gnani overrides
# GNANI_BASE_URL=https://api.vachana.ai
# GNANI_TTS_SAMPLE_RATE=48000

# LLM for grammar, structure and fact feedback (Gemini REST)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING=low   (low or high; "off" for models without thinking levels)

# Sign-in (Clerk, from the Vercel Marketplace: `vercel integration add clerk`, then `vercel env pull`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Usage limits per Google account (see src/lib/quota.ts)
# BOLO_FREE_ATTEMPTS=1
# Comma separated emails with no limits, for testing and recording
BOLO_UNLIMITED_EMAILS=

# YouTube link of the demo video, shown on the home page (hidden when empty)
NEXT_PUBLIC_DEMO_VIDEO_URL=
